{
	"type": "module",
	"name": "api",
	"version": "1.0.0",
	"description": "API backend construída com Elysia, Prisma, JWT e validações com Zod",
	"main": "index.js",
	"scripts": {
		"build": "bun build src/index.js --target bun --outdir dist --external pg",
		"dev": "bun --preload ./src/instrumentation.js --watch src/index.js",
		"dev:logs": "LOG_PRETTY=false bun --preload ./src/instrumentation.js --watch src/index.js | bun scripts/ship-logs.js",
		"start": "bun --preload ./src/instrumentation.js dist/index.js",
		"test": "bun test",
		"test:unit": "bun test tests/unit",
		"test:integration": "bun test tests/integration",
		"test:watch": "bun test --watch",
		"test:coverage": "bun test --coverage",
		"lint": "biome check .",
		"format": "biome format .",
		"prisma:generate": "bun x prisma generate",
		"prisma:studio": "bun x prisma studio",
		"seed": "bun prisma/seed.js",
		"seed:demo": "SEED_DEMO=true bun prisma/seed.js",
		"permissoes:diff": "bun scripts/sync-permissoes.js",
		"permissoes:sync": "bun scripts/sync-permissoes.js --apply",
		"generate": "plop",
		"generate:crud": "plop 'CRUD Completo'",
		"generate:permissions": "plop 'Adicionar Permissões'",
		"generate:controller": "plop 'Apenas Controller'",
		"load-test:login": "bun run scripts/load-test-login.js"
	},
	"keywords": [
		"elysia",
		"api",
		"prisma",
		"zod",
		"bun",
		"backend"
	],
	"author": "João Pedro",
	"license": "ISC",
	"packageManager": "bun@1.2.23",
	"dependencies": {
		"@elysiajs/cors": "1.4.2",
		"@elysiajs/jwt": "1.4.2",
		"@elysiajs/openapi": "1.4.15",
		"@elysiajs/opentelemetry": "1.4.11",
		"@opentelemetry/api": "1.9.1",
		"@opentelemetry/exporter-metrics-otlp-proto": "0.221.0",
		"@opentelemetry/exporter-trace-otlp-proto": "0.221.0",
		"@opentelemetry/instrumentation-pg": "0.73.0",
		"@opentelemetry/resources": "2.10.0",
		"@opentelemetry/sdk-metrics": "2.10.0",
		"@opentelemetry/sdk-trace-node": "2.10.0",
		"@opentelemetry/semantic-conventions": "1.43.0",
		"@prisma/adapter-pg": "7.2.0",
		"@prisma/client": "7",
		"bcrypt": "^6.0.0",
		"date-fns": "^4.1.0",
		"dotenv": "17.2.3",
		"elysia": "1.4.29",
		"plop": "4.0.4",
		"zod": "^4.1.8"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.4",
		"@faker-js/faker": "10.1.0",
		"@types/bcrypt": "^5.0.2",
		"@types/node": "^24.0.3",
		"autocannon": "8.0.0",
		"prisma": "7"
	}
}
