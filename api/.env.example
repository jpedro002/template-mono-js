
PORT=3000

JWT_SECRET=seu_jwt_secret_aqui
JWT_ALGORITHM=HS256

CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:5173

# Cookie de sessão (JWT httpOnly)
COOKIE_NAME=access_token
# lax | strict | none — "none" exige HTTPS e proteção anti-CSRF própria
COOKIE_SAMESITE=lax
# default: true em produção, false fora dela
COOKIE_SECURE=false
# COOKIE_DOMAIN=.seudominio.com

# Logs
# debug | info | warn | error — default: debug fora de produção, info em produção
LOG_LEVEL=debug
# true = legível e colorido; false = JSON por linha. Default: false em produção
LOG_PRETTY=true




DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Storage de arquivos (S3-like: AWS S3, Cloudflare R2, MinIO, Spaces, Backblaze)
# s3 | memory — "memory" guarda os bytes em processo (dev offline e testes)
STORAGE_DRIVER=s3
# Vazio = AWS. MinIO local: http://localhost:9000
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=app-private
# Opcional: bucket separado para arquivos públicos (avatares)
S3_PUBLIC_BUCKET=app-public
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# false = path-style (MinIO); true = virtual-hosted (AWS, R2)
S3_VIRTUAL_HOSTED=false
# Base pública/CDN na frente do bucket público
S3_PUBLIC_URL=http://localhost:9000/app-public

# Limite global de upload em bytes (o perfil pode ser mais restritivo)
STORAGE_MAX_SIZE=25000000
# Validade da URL assinada, em segundos
STORAGE_PRESIGN_TTL=300
# Acima disso o arquivo não é lido inteiro em memória (não calcula sha256)
STORAGE_CHECKSUM_LIMIT=8000000

# Cache de leitura
# memory | redis | none — "memory" é um Map do processo (basta para uma
# instância); "redis" só compensa com mais de uma instância servindo
CACHE_DRIVER=memory
# TTL padrão em segundos (cada namespace pode pedir outro)
CACHE_TTL=300
# Prefixo de todas as chaves — delimita o que a aplicação pode apagar quando o
# Redis não é exclusivo dela
CACHE_PREFIX=app:cache:
# Só o driver de memória: teto de entradas antes de começar a descartar
CACHE_MAX_ENTRIES=5000
# Valkey/Redis do docker-compose.dev.yml
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT=3000
# Teto de cada operação de cache em ms: cache fora do ar vira miss rápido, não
# segundos somados a cada requisição
CACHE_TIMEOUT=200

# --- E-mail transacional (cadastro, recuperação de senha, troca de e-mail) ---
# "ses" fala a API HTTP do SESv2 direto (SigV4 no Web Crypto, sem SDK).
# "log" só escreve a mensagem no stdout — é o driver de desenvolvimento, não
# exige credencial da AWS. "memory" é fixado nos testes.
MAIL_DRIVER=log
# Endereço remetente. No SES precisa estar verificado (identidade de e-mail ou
# domínio), senão toda chamada é recusada.
MAIL_FROM=nao-responda@exemplo.com.br
MAIL_FROM_NAME=PDCA
# Base dos links que vão no corpo do e-mail — é o web, não a API.
APP_URL=http://localhost:3001
# Teto do envio em ms: SES lento não pode pendurar um cadastro
MAIL_TIMEOUT=8000

# Credenciais do SES. Separadas das de S3 de propósito: o bucket pode estar no
# MinIO/R2 e o e-mail na AWS. A chave só precisa de ses:SendEmail.
# Conta nova do SES começa em sandbox: só envia para endereço verificado.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Credencial temporária (role de task/instância) — vazio com chave estática
AWS_SESSION_TOKEN=

# --- Coletor de logs (só produção, docker-compose.yml) ---
# Basic auth do VictoriaLogs. Sem isto o coletor sobe SEM autenticação e quem
# alcançar a porta lê a trilha de auditoria inteira. Não cobre a ingestão
# syslog (:8094), que não tem auth — quem protege ela é o bind em 127.0.0.1.
VL_AUTH_USER=pdca
VL_AUTH_PASSWORD=troque-isto

OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4318/v1/metrics
OTEL_TRACES_SAMPLER_ARG=0.1
OTEL_DIAG=false
GRAFANA_ADMIN_PASSWORD=troque-isto

IA_DRIVER=gemini
IA_API_KEY=troque-isto
# Pool do Postgres (opcionais; padrões em src/services/_prisma.service.js)
DB_POOL_MAX=10
DB_POOL_TIMEOUT_MS=10000
DB_POOL_IDLE_MS=30000
DB_STATEMENT_TIMEOUT_MS=60000
